# ═══════════════════════════════════════════════════
# yDB Server Configuration
# Copy this file to .env and fill in your values.
#
# REQUIRED: JWT_SECRET and ENCRYPTION_KEY have NO fallback.
# The server will refuse to start without them.
# ═══════════════════════════════════════════════════

# Server
PORT=3000
NODE_ENV=production

# ── REQUIRED SECRETS (no defaults — must be set) ──────────────────────

# JWT signing key (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Token expiry
JWT_EXPIRES_IN=7d

# Dedicated secret for refresh tokens (recommended — falls back to JWT_SECRET if unset)
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# AES-256 encryption key for stored connection passwords (exactly 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=

# ── PostgreSQL (App Database) ─────────────────────────────────────────

PG_HOST=localhost
PG_PORT=5432
PG_USER=ydb
PG_PASSWORD=
PG_DATABASE=ydb_app

# ── Outbound Connection Policy (SSRF) ─────────────────────────────────

# The cloud metadata endpoint (169.254.169.254) is always blocked.
# Set to 'true' to also block connections to private/internal addresses
# (loopback, 10.x, 172.16-31.x, 192.168.x, link-local). Leave unset for
# self-hosted setups that connect to databases on a private network.
YDB_BLOCK_PRIVATE_HOSTS=false

# ── Rate Limiting (per-user, per 15-minute window) ────────────────────

RATE_LIMIT_AUTH=10
RATE_LIMIT_QUERY=200
RATE_LIMIT_GENERAL=500

# ── Password Policy ──────────────────────────────────────────────────

PASSWORD_MIN_LENGTH=12

# ── Backup Configuration ─────────────────────────────────────────────

# Target: 'local' or 's3'
BACKUP_TARGET=local
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30

# S3-compatible backup storage (if BACKUP_TARGET=s3)
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1
# AWS credentials via standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars

# ── AI Provider (Text-to-SQL, SQL assistant, error explainer, etc.) ──
#
# These are DEFAULTS. Admins can override provider/model/keys at runtime from
# the app: Admin → AI tab (stored in the database). Leaving NLQ_MODEL blank lets
# the app pick a sensible default for the chosen provider.
#
# Provider: 'builtin' (offline, no key) | 'bedrock' | 'openai' | 'anthropic' | 'gemini'
NLQ_PROVIDER=builtin

# Model id (optional — blank uses the provider's default)
NLQ_MODEL=

# AWS Bedrock (NLQ_PROVIDER=bedrock): use IAM credentials or a bearer token.
NLQ_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=

# OpenAI / Anthropic / Gemini (NLQ_PROVIDER=openai|anthropic|gemini)
NLQ_API_KEY=
# OpenAI-compatible base URL (only for 'openai'); leave default otherwise.
NLQ_BASE_URL=https://api.openai.com/v1
